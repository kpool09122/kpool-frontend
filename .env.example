# Server-only backend origins (recommended); /api/v1/{context} is added by gateways.
# A full matching /api/v1/{context} URL is also supported; never use NEXT_PUBLIC_.
# Deploy together with kpool-backend#698.
KPOOL_WIKI_PRIVATE_API_BASE_URL=http://127.0.0.1:8080
KPOOL_IDENTITY_API_BASE_URL=http://127.0.0.1:8080
KPOOL_ACCOUNT_API_BASE_URL=http://127.0.0.1:8080
KPOOL_SITE_MANAGEMENT_API_BASE_URL=http://127.0.0.1:8080

# Wiki visitor location signing secret; use the same value as the backend.
# Production: configure as a Cloudflare Worker runtime secret (32+ characters).
WIKI_VISITOR_LOCATION_SECRET=

# Public analytics configuration. Enable only for the intended measurement environment.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GTM_ID=GTM-T958HN6F
