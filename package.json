    "@kpool/types": "workspace:*",
    "@kpool/wiki": "workspace:*",
    "@radix-ui/react-icons": "^1.3.2",
    "@tanstack/react-query": "5.102.8",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
